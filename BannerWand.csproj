  <PropertyGroup>
    <!--
      Deploy target directory: a local staging copy under bin\BannerWand for Debug,
      the actual game Modules folder for Release. $(ProjectDir) contains an ampersand
      (".../Mount & Blade II Bannerlord/...") - deliberately not resolved through a
      PostBuildEvent/xcopy batch script, since cmd.exe treats an unescaped "&" as a
      command separator and silently breaks the copy. MakeDir/Copy/Delete below operate
      on plain string values, so the ampersand is never parsed as shell syntax.
    -->
    <DeployRoot Condition="'$(Configuration)' == 'Debug'">$(ProjectDir)bin\BannerWand\</DeployRoot>
    <DeployRoot Condition="'$(Configuration)' == 'Release'">D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord\Modules\BannerWand\</DeployRoot>
  </PropertyGroup>
  <Target Name="DeployModule" AfterTargets="Build">
    <ItemGroup>
      <ExtraOutputFiles Include="$(TargetDir)*.pdb;$(TargetDir)*.xml;$(TargetDir)TaleWorlds.*.dll" />
      <LanguageFiles Include="$(ProjectDir)ModuleData\Languages\**\*.*" />
    </ItemGroup>
    <Delete Files="@(ExtraOutputFiles)" ContinueOnError="true" />
    <RemoveDir Directories="$(DeployRoot)" Condition="'$(Configuration)' == 'Debug' And Exists('$(DeployRoot)')" />
    <MakeDir Directories="$(DeployRoot)bin\Win64_Shipping_Client" />
    <MakeDir Directories="$(DeployRoot)ModuleData\Languages" />
    <Copy SourceFiles="$(TargetDir)BannerWand.dll" DestinationFolder="$(DeployRoot)bin\Win64_Shipping_Client" />
    <Copy SourceFiles="$(ProjectDir)SubModule.xml" DestinationFolder="$(DeployRoot)" />
    <Copy SourceFiles="@(LanguageFiles)" DestinationFolder="$(DeployRoot)ModuleData\Languages\%(RecursiveDir)" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
