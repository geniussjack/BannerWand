		<string id="BW_NPC_EditFocusPoints" text="포커스 포인트 편집" />
		<string id="BW_NPC_EditFocusPoints_Hint" text="NPC의 포커스 포인트를 추가하거나 제거합니다 (값이 변경될 때 한 번 적용됩니다)." />

		<!-- Inventory Category -->
		<string id="BW_Inventory_EditGold" text="금 편집" />
